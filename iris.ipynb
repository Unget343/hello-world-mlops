import boto3
import joblib
from sklearn.datasets import load_iris
from sklearn.tree import DecisionTreeClassifier
import os
import sklearn

iris = load_iris()
x, y = iris.data, iris.target()

model = DecisionTreeClassifier()
model.fit(x, y)

joblib.dump(model, "iris-model.pkl")
print("model saved as iris-model.pkl")

s3 = boto3.client("s3")
bucket = "example-bucket" # i dont have a AWS account, becouse isnt use AWS S3 

s3.upload_file("iris-model.pkl", bucket, "model-artifacts/iris-model.pkl")
print("uploaded! ", f"s3://(bucket)/model-artfacts/iris-model.pkl")
